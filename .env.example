# ---------------------------------------------------------------------------
# Yash Honda Vacancy & Hiring Tracker - environment
# Copy to `.env.local`. Never commit real values. The service-role key is a
# server-only secret and must never be exposed to the browser under any
# NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REGION.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS and is used exclusively for:
#   - append-only audit writes
#   - cross-role admin queries (audit log, exports, retention worker)
# Every ordinary read goes through the session-bound RLS client in policy.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage buckets (private; created by supabase/storage.sql)
SUPABASE_DOC_BUCKET=candidate-documents
SUPABASE_EXPORT_BUCKET=report-exports

# Signed URL lifetime for document previews, in seconds (DPDP: short-lived)
DOCUMENT_URL_TTL_SECONDS=60

# Deployment guard
APP_ENV=development
TIMEZONE=Asia/Kolkata

# Site URL for auth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true to show demo buttons (keep false for production)
NEXT_PUBLIC_ENABLE_DEMO_LOGINS=false
